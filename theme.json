{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "768px",
			"wideSize": "1280px"
		},
		"color": {
			"background": true,
			"text": true,
			"link": true,
			"custom": true,
			"customDuotone": true,
			"customGradient": true,
			"defaultPalette": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPresets": false,
			"palette": [
				{ "slug": "primary",   "name": "Primary",          "color": "#0F172A" },
				{ "slug": "secondary",  "name": "Secondary",        "color": "#1E293B" },
				{ "slug": "accent",     "name": "Accent",           "color": "#FF6B57" },
				{ "slug": "background", "name": "Background",        "color": "#FFFFFF" },
				{ "slug": "surface",    "name": "Surface",          "color": "#F8FAFC" },
				{ "slug": "text",       "name": "Text",             "color": "#0F172A" },
				{ "slug": "muted",      "name": "Muted Text",       "color": "#64748B" },
				{ "slug": "border",     "name": "Border",           "color": "#E2E8F0" },
				{ "slug": "success",    "name": "Success",          "color": "#15803D" },
				{ "slug": "warning",    "name": "Warning",          "color": "#B45309" },
				{ "slug": "error",      "name": "Error",            "color": "#B91C1C" }
			],
			"gradients": [
				{ "slug": "surface-fade", "name": "Surface Fade",
					"gradient": "linear-gradient(180deg, #F8FAFC 0%, #FFFFFF 100%)" },
				{ "slug": "accent-fade",  "name": "Accent Fade",
					"gradient": "linear-gradient(180deg, rgba(255,107,87,0.08) 0%, rgba(255,107,87,0) 100%)" }
			]
		},
		"typography": {
			"fluid": true,
			"lineHeight": true,
			"letterSpacing": true,
			"dropCap": false,
			"fontStyle": true,
			"fontWeight": true,
			"textTransform": true,
			"textColumns": false,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Inter (Body / UI)",
					"fontFamily": "Inter, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "400", "src": [ "file:./assets/fonts/inter-400.woff2" ] },
						{ "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "500", "src": [ "file:./assets/fonts/inter-500.woff2" ] },
						{ "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "600", "src": [ "file:./assets/fonts/inter-600.woff2" ] },
						{ "fontFamily": "Inter", "fontStyle": "normal", "fontWeight": "700", "src": [ "file:./assets/fonts/inter-700.woff2" ] }
					]
				},
				{
					"slug": "heading",
					"name": "Newsreader (Display)",
					"fontFamily": "Newsreader, Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{ "fontFamily": "Newsreader", "fontStyle": "normal", "fontWeight": "500", "src": [ "file:./assets/fonts/newsreader-500.woff2" ] },
						{ "fontFamily": "Newsreader", "fontStyle": "normal", "fontWeight": "600", "src": [ "file:./assets/fonts/newsreader-600.woff2" ] },
						{ "fontFamily": "Newsreader", "fontStyle": "italic",  "fontWeight": "500", "src": [ "file:./assets/fonts/newsreader-500-italic.woff2" ] }
					]
				},
				{
					"slug": "mono",
					"name": "Mono (Code)",
					"fontFamily": "\"SFMono-Regular\", Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{ "slug": "caption", "name": "Caption",  "size": "0.75rem",   "fluid": false },
				{ "slug": "small",   "name": "Small",    "size": "0.875rem",  "fluid": false },
				{ "slug": "medium",  "name": "Medium",   "size": "1rem",      "fluid": { "min": "0.95rem", "max": "1.05rem" } },
				{ "slug": "large",   "name": "Large",    "size": "1.125rem",  "fluid": { "min": "1rem", "max": "1.25rem" } },
				{ "slug": "x-large", "name": "X-Large",  "size": "1.5rem",    "fluid": { "min": "1.25rem", "max": "1.75rem" } },
				{ "slug": "xx-large","name": "XX-Large", "size": "2.25rem",   "fluid": { "min": "1.75rem", "max": "2.75rem" } },
				{ "slug": "xxx-large","name": "XXX-Large","size": "3.5rem",   "fluid": { "min": "2.5rem", "max": "4.5rem" } },
				{ "slug": "huge",    "name": "Huge",     "size": "5rem",      "fluid": { "min": "3rem", "max": "6.5rem" } }
			]
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true,
			"customSpacingSize": true,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "20", "name": "0.5×",  "size": "0.5rem"  },
				{ "slug": "30", "name": "0.75×", "size": "0.75rem" },
				{ "slug": "40", "name": "1×",    "size": "1rem"    },
				{ "slug": "50", "name": "1.5×",  "size": "1.5rem"  },
				{ "slug": "60", "name": "2×",    "size": "2rem"    },
				{ "slug": "70", "name": "3×",    "size": "3rem"    },
				{ "slug": "80", "name": "4×",    "size": "4rem"    },
				{ "slug": "90", "name": "6×",    "size": "6rem"    }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"custom": {
			"radius": {
				"sm": "2px",
				"md": "4px",
				"lg": "8px",
				"pill": "999px"
			},
			"shadow": {
				"sm": "0 1px 2px rgba(15, 23, 42, 0.04)",
				"md": "0 4px 12px rgba(15, 23, 42, 0.06)",
				"lg": "0 8px 24px rgba(15, 23, 42, 0.08)"
			},
			"transition": {
				"fast": "120ms ease",
				"base": "200ms ease"
			},
			"container": {
				"content": "768px",
				"wide":   "1280px",
				"full":   "100%"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text":       "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize":   "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65",
			"letterSpacing": "0"
		},
		"spacing": {
			"padding": {
				"top":    "0",
				"bottom": "0",
				"left":   "0",
				"right":  "0"
			},
			"blockGap": "var:preset|spacing|50"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--accent)",
						"style": "solid",
						"width": "2px",
						"offset": "2px"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600",
					"lineHeight": "1.2",
					"letterSpacing": "-0.01em"
				},
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--xxx-large)",
					"lineHeight": "1.1",
					"letterSpacing": "-0.02em",
					"fontWeight": "600"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.15",
					"letterSpacing": "-0.02em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"letterSpacing": "0.02em",
					"textTransform": "uppercase"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--background)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500",
					"letterSpacing": "0.01em"
				},
				"spacing": {
					"padding": {
						"top":    "0.75rem",
						"bottom": "0.75rem",
						"left":   "1.25rem",
						"right":  "1.25rem"
					}
				},
				"border": {
					"radius": "var(--wp--custom--radius--sm)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--secondary)"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--accent)",
						"style": "solid",
						"width": "2px",
						"offset": "2px"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--caption)",
					"fontFamily": "var(--wp--preset--font-family--body)"
				},
				"color": {
					"text": "var(--wp--preset--color--muted)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"letterSpacing": "-0.01em"
				},
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"core/site-tagline": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": {
					"text": "var(--wp--preset--color--muted)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--huge)",
					"lineHeight": "1.05",
					"letterSpacing": "-0.03em",
					"fontWeight": "600"
				},
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"core/post-excerpt": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.6"
				},
				"color": {
					"text": "var(--wp--preset--color--muted)"
				}
			},
			"core/post-date": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--caption)",
					"textTransform": "uppercase",
					"letterSpacing": "0.05em"
				},
				"color": {
					"text": "var(--wp--preset--color--muted)"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontStyle": "italic",
					"lineHeight": "1.35"
				},
				"border": {
					"left": {
						"color": "var(--wp--preset--color--accent)",
						"style": "solid",
						"width": "2px"
					}
				},
				"spacing": {
					"padding": {
						"left": "1.5rem"
					}
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontStyle": "italic",
					"lineHeight": "1.25"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--border)"
				}
			},
			"core/search": {
				"border": {
					"radius": "var(--wp--custom--radius--sm)"
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page (No Title)",
			"postTypes": [ "page" ]
		}
	],
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "mobile-menu",
			"title": "Mobile Menu",
			"area": "navigation"
		}
	]
}
