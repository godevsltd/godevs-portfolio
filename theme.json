{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "GoDevs Portfolio",
	"description": "A premium, Gutenberg-first Full Site Editing block theme for portfolios, editorial sites, and personal brands.",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"background": true,
			"button": true,
			"caption": true,
			"custom": true,
			"customGradient": true,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [],
			"gradients": [],
			"heading": true,
			"link": true,
			"palette": [
				{
					"slug": "primary",
					"color": "#0A0A0A",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#3D3D3D",
					"name": "Secondary"
				},
				{
					"slug": "accent",
					"color": "#1D4ED8",
					"name": "Accent"
				},
				{
					"slug": "accent-hover",
					"color": "#1E40AF",
					"name": "Accent Hover"
				},
				{
					"slug": "base",
					"color": "#FAFAF7",
					"name": "Base"
				},
				{
					"slug": "surface",
					"color": "#FFFFFF",
					"name": "Surface"
				},
				{
					"slug": "surface-elevated",
					"color": "#FFFFFF",
					"name": "Surface Elevated"
				},
				{
					"slug": "surface-muted",
					"color": "#F5F5F0",
					"name": "Surface Muted"
				},
				{
					"slug": "foreground",
					"color": "#0A0A0A",
					"name": "Foreground"
				},
				{
					"slug": "muted",
					"color": "#5C5C56",
					"name": "Muted Foreground"
				},
				{
					"slug": "border",
					"color": "#E6E6E0",
					"name": "Border"
				},
				{
					"slug": "success",
					"color": "#15803D",
					"name": "Success"
				},
				{
					"slug": "warning",
					"color": "#B45309",
					"name": "Warning"
				},
				{
					"slug": "error",
					"color": "#B91C1C",
					"name": "Error"
				},
				{
					"slug": "contrast",
					"color": "#FFFFFF",
					"name": "Contrast"
				}
			],
			"text": true
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "1320px"
		},
		"spacing": {
			"customSpacingSize": true,
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"slug": "0",
					"size": "0",
					"name": "None"
				},
				{
					"slug": "10",
					"size": "0.25rem",
					"name": "3XS"
				},
				{
					"slug": "15",
					"size": "0.375rem",
					"name": "3XS+"
				},
				{
					"slug": "20",
					"size": "0.5rem",
					"name": "2XS"
				},
				{
					"slug": "30",
					"size": "0.75rem",
					"name": "XS"
				},
				{
					"slug": "40",
					"size": "1rem",
					"name": "SM"
				},
				{
					"slug": "50",
					"size": "1.5rem",
					"name": "MD"
				},
				{
					"slug": "60",
					"size": "2rem",
					"name": "LG"
				},
				{
					"slug": "70",
					"size": "3rem",
					"name": "XL"
				},
				{
					"slug": "80",
					"size": "4rem",
					"name": "2XL"
				},
				{
					"slug": "90",
					"size": "6rem",
					"name": "3XL"
				},
				{
					"slug": "100",
					"size": "8rem",
					"name": "4XL"
				}
			],
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			]
		},
		"typography": {
			"customFontSize": true,
			"customLineHeight": true,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "\"Inter\", \"SF Pro Display\", \"Segoe UI\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "\"Inter\", \"SF Pro Text\", \"Segoe UI\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Mono",
					"fontFamily": "\"SF Mono\", \"JetBrains Mono\", \"Menlo\", \"Consolas\", \"Liberation Mono\", monospace"
				},
				{
					"slug": "serif",
					"name": "Serif",
					"fontFamily": "\"Georgia\", \"Times New Roman\", \"Times\", serif"
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"size": "0.75rem",
					"name": "Caption"
				},
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "normal",
					"size": "1.0625rem",
					"name": "Body",
					"fluid": {
						"min": "1rem",
						"max": "1.0625rem"
					}
				},
				{
					"slug": "medium",
					"size": "1.25rem",
					"name": "Large Body",
					"fluid": {
						"min": "1.125rem",
						"max": "1.375rem"
					}
				},
				{
					"slug": "large",
					"size": "1.5rem",
					"name": "H3",
					"fluid": {
						"min": "1.25rem",
						"max": "1.75rem"
					}
				},
				{
					"slug": "x-large",
					"size": "2rem",
					"name": "H2",
					"fluid": {
						"min": "1.625rem",
						"max": "2.25rem"
					}
				},
				{
					"slug": "xx-large",
					"size": "2.75rem",
					"name": "H1",
					"fluid": {
						"min": "2rem",
						"max": "3.25rem"
					}
				},
				{
					"slug": "xxx-large",
					"size": "4rem",
					"name": "Display",
					"fluid": {
						"min": "2.75rem",
						"max": "5rem"
					}
				},
				{
					"slug": "huge",
					"size": "5.5rem",
					"name": "Display Hero",
					"fluid": {
						"min": "3.25rem",
						"max": "6.5rem"
					}
				}
			],
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"textDecoration": true,
			"textTransform": true,
			"writingMode": false
		},
		"border": {
			"color": true,
			"radius": {
				"defaultRadius": true,
				"radii": [
					{
						"slug": "none",
						"size": "0",
						"name": "None"
					},
					{
						"slug": "sm",
						"size": "4px",
						"name": "Small"
					},
					{
						"slug": "md",
						"size": "8px",
						"name": "Medium"
					},
					{
						"slug": "lg",
						"size": "12px",
						"name": "Large"
					},
					{
						"slug": "xl",
						"size": "16px",
						"name": "X-Large"
					},
					{
						"slug": "2xl",
						"size": "24px",
						"name": "2X-Large"
					},
					{
						"slug": "pill",
						"size": "9999px",
						"name": "Pill"
					}
				]
			},
			"style": true,
			"width": true
		},
		"shadow": {
			"presets": [
				{
					"slug": "flat",
					"name": "Flat",
					"shadow": "none"
				},
				{
					"slug": "raised",
					"name": "Raised",
					"shadow": "0 4px 12px rgba(10, 10, 10, 0.06)"
				},
				{
					"slug": "elevated",
					"name": "Elevated",
					"shadow": "0 12px 32px rgba(10, 10, 10, 0.08)"
				},
				{
					"slug": "floating",
					"name": "Floating",
					"shadow": "0 20px 48px rgba(10, 10, 10, 0.12)"
				}
			]
		},
		"custom": {
			"motion": {
				"duration": {
					"fast": "150ms",
					"base": "300ms",
					"slow": "500ms"
				},
				"ease": "cubic-bezier(0.4, 0, 0.2, 1)"
			},
			"radius": {
				"sm": "4px",
				"md": "8px",
				"lg": "12px",
				"xl": "16px",
				"2xl": "24px",
				"pill": "9999px"
			},
			"shadow": {
				"sm": "0 1px 2px rgba(10, 10, 10, 0.04)",
				"md": "0 4px 12px rgba(10, 10, 10, 0.06)",
				"lg": "0 12px 32px rgba(10, 10, 10, 0.08)",
				"xl": "0 20px 48px rgba(10, 10, 10, 0.12)"
			},
			"transition": {
				"fast": "150ms cubic-bezier(0.4, 0, 0.2, 1)",
				"base": "300ms cubic-bezier(0.4, 0, 0.2, 1)"
			},
			"container": {
				"content": "680px",
				"wide": "1320px"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|foreground"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "var:preset|spacing|50",
				"bottom": "0",
				"left": "var:preset|spacing|50"
			},
			"blockGap": "var:preset|spacing|50"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|normal",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|accent"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|accent-hover"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus": {
					"outline": {
						"color": "var:preset|color|accent",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|primary"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "700",
					"lineHeight": "1.15",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|xx-large",
					"lineHeight": "1.08",
					"letterSpacing": "-0.025em",
					"fontWeight": "700"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|x-large",
					"lineHeight": "1.15",
					"letterSpacing": "-0.02em",
					"fontWeight": "700"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|large",
					"lineHeight": "1.2",
					"letterSpacing": "-0.01em",
					"fontWeight": "600"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|medium",
					"lineHeight": "1.3",
					"fontWeight": "600"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|normal",
					"fontWeight": "600"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|x-small",
					"fontWeight": "600",
					"textTransform": "uppercase",
					"letterSpacing": "0.1em"
				}
			},
			"button": {
				"border": {
					"radius": "var(--wp--custom--radius--md, 8px)"
				},
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|contrast"
				},
				"spacing": {
					"padding": {
						"top": "calc(var(--wp--preset--spacing--40, 1rem) - 1px)",
						"right": "var(--wp--preset--spacing--70, 3rem)",
						"bottom": "calc(var(--wp--preset--spacing--40, 1rem) - 1px)",
						"left": "var(--wp--preset--spacing--70, 3rem)"
					}
				},
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|normal",
					"fontWeight": "600",
					"lineHeight": "1"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|accent-hover"
					}
				},
				":active": {
					"color": {
						"background": "var:preset|color|primary"
					},
					"typography": {
						"fontWeight": "600"
					}
				},
				":focus": {
					"outline": {
						"color": "var:preset|color|accent",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				},
				":visited": {
					"color": {
						"text": "var:preset|color|contrast"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|x-small",
					"textAlign": "center",
					"lineHeight": "1.5"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "700",
					"letterSpacing": "-0.01em"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|xx-large",
					"fontWeight": "700",
					"lineHeight": "1.1",
					"letterSpacing": "-0.02em"
				}
			},
			"core/post-excerpt": {
				"typography": {
					"fontSize": "var:preset|font-size|normal",
					"lineHeight": "1.6"
				},
				"color": {
					"text": "var:preset|color|secondary"
				}
			},
			"core/post-date": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/post-terms": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|accent"
						}
					}
				}
			},
			"core/post-author-name": {
				"color": {
					"text": "var:preset|color|muted"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/query-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "700"
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|border"
				},
				"typography": {
					"fontSize": "var:preset|font-size|medium"
				}
			},
			"core/search": {
				"border": {
					"radius": "4px"
				},
				"typography": {
					"fontSize": "var:preset|font-size|normal"
				}
			},
			"core/comment-content": {
				"typography": {
					"fontSize": "var:preset|font-size|normal",
					"lineHeight": "1.6"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|x-large",
					"lineHeight": "1.3",
					"letterSpacing": "-0.01em"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|40",
						"bottom": "var:preset|spacing|40"
					}
				},
				"elements": {
					"cite": {
						"typography": {
							"fontSize": "var:preset|font-size|small",
							"fontStyle": "normal",
							"fontWeight": "500"
						},
						"color": {
							"text": "var:preset|color|muted"
						}
					}
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|large",
					"lineHeight": "1.4"
				},
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|50"
					}
				},
				"border": {
					"left": {
						"color": "var:preset|color|accent",
						"width": "2px",
						"style": "solid"
					}
				},
				"elements": {
					"cite": {
						"typography": {
							"fontSize": "var:preset|font-size|small",
							"fontStyle": "normal"
						},
						"color": {
							"text": "var:preset|color|muted"
						}
					}
				}
			},
			"core/image": {
				"border": {
					"radius": "4px"
				}
			},
			"core/cover": {
				"dimensions": {
					"minHeight": "480px"
				}
			},
			"core/buttons": {
				"spacing": {
					"blockGap": "var:preset|spacing|30"
				}
			},
			"core/heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "700"
				}
			},
			"core/list": {
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|50"
					}
				}
			},
			"core/details": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|40",
						"bottom": "var:preset|spacing|40"
					}
				},
				"border": {
					"bottom": {
						"color": "var:preset|color|border",
						"width": "1px",
						"style": "solid"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|normal",
					"lineHeight": "1.6"
				}
			},
			"core/avatar": {
				"border": {
					"radius": "9999px"
				}
			},
			"core/media-text": {
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|50",
						"right": "var:preset|spacing|50",
						"bottom": "var:preset|spacing|50",
						"left": "var:preset|spacing|50"
					}
				}
			},
			"core/read-more": {
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "600",
					"textDecoration": "underline"
				},
				"color": {
					"text": "var:preset|color|accent"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|accent"
						}
					}
				}
			},
			"core/code": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|small"
				},
				"color": {
					"background": "var:preset|color|surface-muted"
				},
				"border": {
					"radius": "4px"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|40",
						"right": "var:preset|spacing|50",
						"bottom": "var:preset|spacing|40",
						"left": "var:preset|spacing|50"
					}
				}
			},
			"core/gallery": {
				"spacing": {
					"margin": {
						"bottom": "var:preset|spacing|60"
					}
				}
			},
			"core/spacer": {
