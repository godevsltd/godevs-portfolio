{
        "$schema": "https://schemas.wp.org/trunk/theme.json",
        "version": 3,
        "title": "GoDevs Portfolio",
        "description": "A premium, Gutenberg-first Full Site Editing block theme for portfolios, editorial sites, and personal brands.",
        "settings": {
                "appearanceTools": true,
                "useRootPaddingAwareAlignments": true,
                "color": {
                        "background": true,
                        "button": true,
                        "caption": true,
                        "custom": true,
                        "customGradient": true,
                        "defaultDuotone": false,
                        "defaultGradients": false,
                        "defaultPalette": false,
                        "duotone": [],
                        "gradients": [],
                        "heading": true,
                        "link": true,
                        "palette": [
                                {
                                        "slug": "primary",
                                        "color": "#0A0A0A",
                                        "name": "Primary"
                                },
                                {
                                        "slug": "secondary",
                                        "color": "#3D3D3D",
                                        "name": "Secondary"
                                },
                                {
                                        "slug": "accent",
                                        "color": "#2563EB",
                                        "name": "Accent"
                                },
                                {
                                        "slug": "base",
                                        "color": "#FAFAF7",
                                        "name": "Base"
                                },
                                {
                                        "slug": "surface",
                                        "color": "#FFFFFF",
                                        "name": "Surface"
                                },
                                {
                                        "slug": "surface-elevated",
                                        "color": "#FFFFFF",
                                        "name": "Surface Elevated"
                                },
                                {
                                        "slug": "foreground",
                                        "color": "#0A0A0A",
                                        "name": "Foreground"
                                },
                                {
                                        "slug": "muted",
                                        "color": "#6B7280",
                                        "name": "Muted"
                                },
                                {
                                        "slug": "border",
                                        "color": "#E5E5E0",
                                        "name": "Border"
                                },
                                {
                                        "slug": "success",
                                        "color": "#15803D",
                                        "name": "Success"
                                },
                                {
                                        "slug": "warning",
                                        "color": "#B45309",
                                        "name": "Warning"
                                },
                                {
                                        "slug": "error",
                                        "color": "#B91C1C",
                                        "name": "Error"
                                },
                                {
                                        "slug": "contrast",
                                        "color": "#FFFFFF",
                                        "name": "Contrast"
                                }
                        ],
                        "text": true
                },
                "layout": {
                        "contentSize": "640px",
                        "wideSize": "1280px"
                },
                "spacing": {
                        "customSpacingSize": true,
                        "spacingScale": {
                                "steps": 0
                        },
                        "spacingSizes": [
                                {
                                        "slug": "20",
                                        "size": "0.5rem",
                                        "name": "2XS"
                                },
                                {
                                        "slug": "30",
                                        "size": "0.75rem",
                                        "name": "XS"
                                },
                                {
                                        "slug": "40",
                                        "size": "1rem",
                                        "name": "SM"
                                },
                                {
                                        "slug": "50",
                                        "size": "1.5rem",
                                        "name": "MD"
                                },
                                {
                                        "slug": "60",
                                        "size": "2rem",
                                        "name": "LG"
                                },
                                {
                                        "slug": "70",
                                        "size": "3rem",
                                        "name": "XL"
                                },
                                {
                                        "slug": "80",
                                        "size": "4rem",
                                        "name": "2XL"
                                },
                                {
                                        "slug": "90",
                                        "size": "6rem",
                                        "name": "3XL"
                                },
                                {
                                        "slug": "100",
                                        "size": "8rem",
                                        "name": "4XL"
                                }
                        ],
                        "units": ["px", "em", "rem", "vh", "vw", "%"]
                },
                "typography": {
                        "customFontSize": true,
                        "customLineHeight": true,
                        "dropCap": false,
                        "fluid": true,
                        "fontFamilies": [
                                {
                                        "slug": "display",
                                        "name": "Display",
                                        "fontFamily": "\"Inter\", \"SF Pro Display\", \"Segoe UI\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", Arial, sans-serif"
                                },
                                {
                                        "slug": "body",
                                        "name": "Body",
                                        "fontFamily": "\"Inter\", \"SF Pro Text\", \"Segoe UI\", system-ui, -apple-system, BlinkMacSystemFont, \"Helvetica Neue\", Arial, sans-serif"
                                },
                                {
                                        "slug": "mono",
                                        "name": "Mono",
                                        "fontFamily": "\"SF Mono\", \"JetBrains Mono\", \"Menlo\", \"Consolas\", \"Liberation Mono\", monospace"
                                },
                                {
                                        "slug": "serif",
                                        "name": "Serif",
                                        "fontFamily": "\"Georgia\", \"Times New Roman\", \"Times\", serif"
                                }
                        ],
                        "fontSizes": [
                                {
                                        "slug": "x-small",
                                        "size": "0.75rem",
                                        "name": "Caption"
                                },
                                {
                                        "slug": "small",
                                        "size": "0.875rem",
                                        "name": "Small"
                                },
                                {
                                        "slug": "normal",
                                        "size": "1.125rem",
                                        "name": "Body",
                                        "fluid": {
                                                "min": "1rem",
                                                "max": "1.125rem"
                                        }
                                },
                                {
                                        "slug": "medium",
                                        "size": "1.25rem",
                                        "name": "Large Body",
                                        "fluid": {
                                                "min": "1.125rem",
                                                "max": "1.5rem"
                                        }
                                },
                                {
                                        "slug": "large",
                                        "size": "1.5rem",
                                        "name": "H3",
                                        "fluid": {
                                                "min": "1.25rem",
                                                "max": "2rem"
                                        }
                                },
                                {
                                        "slug": "x-large",
                                        "size": "2.25rem",
                                        "name": "H2",
                                        "fluid": {
                                                "min": "1.875rem",
                                                "max": "2.75rem"
                                        }
                                },
                                {
                                        "slug": "xx-large",
                                        "size": "3rem",
                                        "name": "H1",
                                        "fluid": {
                                                "min": "2.25rem",
                                                "max": "3.75rem"
                                        }
                                },
                                {
                                        "slug": "xxx-large",
                                        "size": "3.75rem",
                                        "name": "Display",
                                        "fluid": {
                                                "min": "2.75rem",
                                                "max": "5.5rem"
                                        }
                                }
                        ],
                        "fontStyle": true,
                        "fontWeight": true,
                        "letterSpacing": true,
                        "textDecoration": true,
                        "textTransform": true,
                        "writingMode": false
                },
                "border": {
                        "color": true,
                        "radius": true,
                        "style": true,
                        "width": true
                }
        },
        "styles": {
                "color": {
                        "background": "var:preset|color|base",
                        "text": "var:preset|color|foreground"
                },
                "spacing": {
                        "padding": {
                                "top": "0",
                                "right": "var:preset|spacing|50",
                                "bottom": "0",
                                "left": "var:preset|spacing|50"
                        },
                        "blockGap": "var:preset|spacing|50"
                },
                "typography": {
                        "fontFamily": "var:preset|font-family|body",
                        "fontSize": "var:preset|font-size|normal",
                        "lineHeight": "1.7"
                },
                "elements": {
                        "link": {
                                "color": {
                                        "text": "var:preset|color|accent"
                                },
                                "typography": {
                                        "textDecoration": "none"
                                },
                                ":hover": {
                                        "typography": {
                                                "textDecoration": "underline"
                                        }
                                },
                                ":focus": {
                                        "outline": {
                                                "color": "var:preset|color|accent",
                                                "offset": "2px",
                                                "style": "solid",
                                                "width": "2px"
                                        }
                                }
                        },
                        "heading": {
                                "color": {
                                        "text": "var:preset|color|primary"
                                },
                                "typography": {
                                        "fontFamily": "var:preset|font-family|display",
                                        "fontWeight": "700",
                                        "lineHeight": "1.15",
                                        "letterSpacing": "-0.015em"
                                }
                        },
                        "h1": {
                                "typography": {
                                        "fontSize": "var:preset|font-size|xx-large",
                                        "lineHeight": "1.08",
                                        "letterSpacing": "-0.025em",
                                        "fontWeight": "700"
                                }
                        },
                        "h2": {
                                "typography": {
                                        "fontSize": "var:preset|font-size|x-large",
                                        "lineHeight": "1.12",
                                        "fontWeight": "700"
                                }
                        },
                        "h3": {
                                "typography": {
                                        "fontSize": "var:preset|font-size|large",
                                        "lineHeight": "1.2",
                                        "fontWeight": "600"
                                }
                        },
                        "h4": {
                                "typography": {
                                        "fontSize": "var:preset|font-size|medium",
                                        "fontWeight": "600"
                                }
                        },
                        "h5": {
                                "typography": {
                                        "fontSize": "var:preset|font-size|normal",
                                        "fontWeight": "600"
                                }
                        },
                        "h6": {
                                "typography": {
                                        "fontSize": "var:preset|font-size|small",
                                        "fontWeight": "600",
                                        "textTransform": "uppercase",
                                        "letterSpacing": "0.08em"
                                }
                        },
                        "button": {
                                "border": {
                                        "radius": "4px"
                                },
                                "color": {
                                        "background": "var:preset|color|primary",
                                        "text": "var:preset|color|contrast"
                                },
                                "spacing": {
                                        "padding": {
                                                "top": "var:preset|spacing|40",
                                                "right": "var:preset|spacing|70",
                                                "bottom": "var:preset|spacing|40",
                                                "left": "var:preset|spacing|70"
                                        }
                                },
                                "typography": {
                                        "fontFamily": "var:preset|font-family|body",
                                        "fontSize": "var:preset|font-size|normal",
                                        "fontWeight": "600",
                                        "lineHeight": "1"
                                },
                                ":hover": {
                                        "color": {
                                                "background": "var:preset|color|secondary"
                                        }
                                },
                                ":active": {
                                        "color": {
                                                "background": "var:preset|color|primary"
                                        }
                                },
                                ":focus": {
                                        "outline": {
                                                "color": "var:preset|color|accent",
                                                "offset": "2px",
                                                "style": "solid",
                                                "width": "2px"
                                        }
                                }
                        },
                        "caption": {
                                "color": {
                                        "text": "var:preset|color|muted"
                                },
                                "typography": {
                                        "fontSize": "var:preset|font-size|small",
                                        "textAlign": "center",
                                        "lineHeight": "1.5"
                                }
                        }
                },
                "blocks": {
                        "core/site-title": {
                                "typography": {
                                        "fontFamily": "var:preset|font-family|display",
                                        "fontSize": "var:preset|font-size|large",
                                        "fontWeight": "700"
                                }
                        },
                        "core/navigation": {
                                "typography": {
                                        "fontFamily": "var:preset|font-family|body",
                                        "fontSize": "var:preset|font-size|normal",
                                        "fontWeight": "500"
                                }
                        },
                        "core/post-title": {
                                "typography": {
                                        "fontFamily": "var:preset|font-family|display",
                                        "fontSize": "var:preset|font-size|xx-large",
                                        "fontWeight": "700",
                                        "lineHeight": "1.1",
                                        "letterSpacing": "-0.02em"
                                }
                        },
                        "core/post-excerpt": {
                                "typography": {
                                        "fontSize": "var:preset|font-size|normal",
                                        "lineHeight": "1.6"
                                }
                        },
                        "core/post-date": {
                                "color": {
                                        "text": "var:preset|color|muted"
                                },
                                "typography": {
                                        "fontSize": "var:preset|font-size|small"
                                }
                        },
                        "core/post-terms": {
                                "color": {
                                        "text": "var:preset|color|muted"
                                },
                                "typography": {
                                        "fontSize": "var:preset|font-size|small"
                                },
                                "elements": {
                                        "link": {
                                                "color": {
                                                        "text": "var:preset|color|accent"
                                                }
                                        }
                                }
                        },
                        "core/post-author-name": {
                                "color": {
                                        "text": "var:preset|color|muted"
                                },
                                "typography": {
                                        "fontSize": "var:preset|font-size|small"
                                }
                        },
                        "core/query-title": {
                                "typography": {
                                        "fontFamily": "var:preset|font-family|display",
                                        "fontSize": "var:preset|font-size|x-large",
                                        "fontWeight": "700"
                                }
                        },
                        "core/separator": {
                                "color": {
                                        "text": "var:preset|color|border"
                                },
                                "typography": {
                                        "fontSize": "var:preset|font-size|medium"
                                }
                        },
                        "core/search": {
                                "border": {
                                        "radius": "4px"
                                },
                                "typography": {
                                        "fontSize": "var:preset|font-size|normal"
                                }
                        },
                        "core/comment-content": {
                                "typography": {
                                        "fontSize": "var:preset|font-size|normal",
                                        "lineHeight": "1.6"
                                }
                        },
                        "core/pullquote": {
                                "typography": {
                                        "fontFamily": "var:preset|font-family|display",
                                        "fontSize": "var:preset|font-size|x-large",
                                        "lineHeight": "1.3",
                                        "letterSpacing": "-0.01em"
                                },
                                "spacing": {
                                        "padding": {
                                                "top": "var:preset|spacing|40",
                                                "bottom": "var:preset|spacing|40"
                                        }
                                },
                                "elements": {
                                        "cite": {
                                                "typography": {
                                                        "fontSize": "var:preset|font-size|small",
                                                        "fontStyle": "normal",
                                                        "fontWeight": "500"
                                                },
                                                "color": {
                                                        "text": "var:preset|color|muted"
                                                }
                                        }
                                }
                        },
                        "core/quote": {
                                "typography": {
                                        "fontFamily": "var:preset|font-family|display",
                                        "fontSize": "var:preset|font-size|large",
                                        "lineHeight": "1.4"
                                },
                                "spacing": {
                                        "padding": {
                                                "left": "var:preset|spacing|50"
                                        }
                                },
                                "border": {
                                        "left": {
                                                "color": "var:preset|color|accent",
                                                "width": "2px",
                                                "style": "solid"
                                        }
                                },
                                "elements": {
                                        "cite": {
                                                "typography": {
                                                        "fontSize": "var:preset|font-size|small",
                                                        "fontStyle": "normal"
                                                },
                                                "color": {
                                                        "text": "var:preset|color|muted"
                                                }
                                        }
                                }
                        },
                        "core/image": {
                                "border": {
                                        "radius": "4px"
                                }
                        },
                        "core/cover": {
                                "dimensions": {
                                        "minHeight": "480px"
                                }
                        },
                        "core/buttons": {
                                "spacing": {
                                        "blockGap": "var:preset|spacing|30"
                                }
                        },
                        "core/heading": {
                                "typography": {
                                        "fontFamily": "var:preset|font-family|display",
                                        "fontWeight": "700"
                                }
                        },
                        "core/list": {
                                "spacing": {
                                        "padding": {
                                                "left": "var:preset|spacing|50"
                                        }
                                }
                        },
                        "core/details": {
                                "spacing": {
                                        "padding": {
                                                "top": "var:preset|spacing|40",
                                                "bottom": "var:preset|spacing|40"
                                        }
                                },
                                "border": {
                                        "bottom": {
                                                "color": "var:preset|color|border",
                                                "width": "1px",
                                                "style": "solid"
                                        }
                                },
                                "typography": {
                                        "fontSize": "var:preset|font-size|normal",
                                        "lineHeight": "1.6"
                                }
                        },
                        "core/avatar": {
                                "border": {
                                        "radius": "9999px"
                                }
                        },
                        "core/media-text": {
                                "spacing": {
                                        "padding": {
                                                "top": "var:preset|spacing|50",
                                                "right": "var:preset|spacing|50",
                                                "bottom": "var:preset|spacing|50",
                                                "left": "var:preset|spacing|50"
                                        }
                                }
                        },
                        "core/post-excerpt": {
                                "typography": {
                                        "fontSize": "var:preset|font-size|normal",
                                        "lineHeight": "1.6"
                                },
                                "color": {
                                        "text": "var:preset|color|secondary"
                                }
                        },
                        "core/read-more": {
                                "typography": {
                                        "fontSize": "var:preset|font-size|small",
                                        "fontWeight": "600"
                                },
                                "color": {
                                        "text": "var:preset|color|accent"
                                },
                                "typography": {
                                        "textDecoration": "underline"
                                },
                                "elements": {
                                        "link": {
                                                "color": {
                                                        "text": "var:preset|color|accent"
                                                }
                                        }
                                }
                        }
                }
        },
        "customTemplates": [
                {
                        "name": "page-portfolio",
                        "title": "Portfolio Landing",
                        "postTypes": ["page"]
                },
                {
                        "name": "page-case-study",
                        "title": "Case Study",
                        "postTypes": ["page"]
                },
                {
                        "name": "page-services",
                        "title": "Services Landing",
                        "postTypes": ["page"]
                },
                {
                        "name": "page-about",
                        "title": "About Long-form",
                        "postTypes": ["page"]
                }
        ],
        "templateParts": [
                {
                        "name": "header",
                        "title": "Header",
                        "description": "Default site header with logo, navigation, and primary CTA."
                },
                {
                        "name": "header-minimal",
                        "title": "Header Minimal",
                        "description": "Minimal header with logo and navigation only."
                },
                {
                        "name": "header-transparent",
                        "title": "Header Transparent",
                        "description": "Transparent header for use over hero covers."
                },
                {
                        "name": "header-centered",
                        "title": "Header Centered",
                        "description": "Centered header with logo above a centered navigation."
                },
                {
                        "name": "header-split",
                        "title": "Header Split",
                        "description": "Split header with logo on the left and site title + tagline grouped together."
                },
                {
                        "name": "header-with-search",
                        "title": "Header With Search",
                        "description": "Header with a search affordance in the navigation row."
                },
                {
                        "name": "header-with-language-switcher",
                        "title": "Header With Language Switcher",
                        "description": "Header with a small language switcher label beside the navigation."
                },
                {
                        "name": "header-portfolio",
                        "title": "Header Portfolio",
                        "description": "Portfolio-focused header with a pill-style CTA button."
                },
                {
                        "name": "header-dark",
                        "title": "Header Dark",
                        "description": "Dark inverted header with primary background and contrast text."
                },
                {
                        "name": "header-cta",
                        "title": "Header CTA",
                        "description": "Header with a text-link CTA instead of a button."
                },
                {
                        "name": "header-editorial",
                        "title": "Header Editorial",
                        "description": "Magazine-style header with masthead, date, and centered navigation beneath a divider."
                },
                {
                        "name": "header-stacked",
                        "title": "Header Stacked",
                        "description": "Stacked header with large centered title, divider, and navigation below."
                },
                {
                        "name": "footer",
                        "title": "Footer",
                        "description": "Default site footer with brand, navigation, and social links."
                },
                {
                        "name": "footer-minimal",
                        "title": "Footer Minimal",
                        "description": "Minimal footer with logo and copyright only."
                },
                {
                        "name": "footer-cta",
                        "title": "Footer CTA",
                        "description": "Footer with a call-to-action band above the footer content."
                },
                {
                        "name": "footer-newsletter",
                        "title": "Footer Newsletter",
                        "description": "Footer with a newsletter signup area above the footer content."
                },
                {
                        "name": "footer-multi-column",
                        "title": "Footer Multi Column",
                        "description": "Multi-column footer with brand, navigation, and contact information."
                },
                {
                        "name": "footer-compact",
                        "title": "Footer Compact",
                        "description": "Compact single-row footer with brand and copyright."
                },
                {
                        "name": "footer-dark",
                        "title": "Footer Dark",
                        "description": "Dark inverted footer with primary background."
                },
                {
                        "name": "footer-social",
                        "title": "Footer Social",
                        "description": "Social-led footer with prominent social icons row."
                },
                {
                        "name": "footer-portfolio",
                        "title": "Footer Portfolio",
                        "description": "Portfolio-focused footer with quick links and contact email."
                },
                {
                        "name": "footer-editorial",
                        "title": "Footer Editorial",
                        "description": "Magazine-style footer with masthead and small navigation row."
                },
                {
                        "name": "footer-large-type",
                        "title": "Footer Large Type",
                        "description": "Footer dominated by an oversized brand wordmark and minimal supporting text."
                }
        ]
}
