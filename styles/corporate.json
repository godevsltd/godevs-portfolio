{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"title": "Corporate",
	"description": "A professional corporate identity — Inter throughout (sans-serif headings), steel blue accent in place of coral, square buttons, always-underlined links. For consultancies, B2B service firms, and professional services that need a conservative, trustworthy look.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "primary",    "name": "Primary",     "color": "#1E293B" },
				{ "slug": "secondary",  "name": "Secondary",   "color": "#334155" },
				{ "slug": "accent",      "name": "Accent",      "color": "#2563EB" },
				{ "slug": "background",  "name": "Background",  "color": "#FFFFFF" },
				{ "slug": "surface",     "name": "Surface",     "color": "#F1F5F9" },
				{ "slug": "text",        "name": "Text",        "color": "#0F172A" },
				{ "slug": "muted",       "name": "Muted Text",  "color": "#64748B" },
				{ "slug": "border",      "name": "Border",      "color": "#CBD5E1" },
				{ "slug": "success",     "name": "Success",     "color": "#15803D" },
				{ "slug": "warning",     "name": "Warning",     "color": "#B45309" },
				{ "slug": "error",       "name": "Error",        "color": "#B91C1C" }
			],
			"gradients": [
				{ "slug": "surface-fade", "name": "Surface Fade",
					"gradient": "linear-gradient(180deg, #F1F5F9 0%, #FFFFFF 100%)" },
				{ "slug": "accent-fade",  "name": "Accent Fade",
					"gradient": "linear-gradient(180deg, rgba(37,99,235,0.06) 0%, rgba(37,99,235,0) 100%)" }
			]
		},
		"custom": {
			"radius": {
				"sm": "0",
				"md": "2px",
				"lg": "4px",
				"pill": "999px"
			},
			"shadow": {
				"sm": "0 1px 2px rgba(15, 23, 42, 0.06)",
				"md": "0 2px 8px rgba(15, 23, 42, 0.08)",
				"lg": "0 6px 20px rgba(15, 23, 42, 0.10)"
			}
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"lineHeight": "1.65"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "600",
					"letterSpacing": "-0.015em",
					"lineHeight": "1.25"
				},
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "700",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.15"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "600"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--background)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "500",
					"fontSize": "var(--wp--preset--font-size--small)",
					"letterSpacing": "0"
				},
				"spacing": {
					"padding": {
						"top":    "0.875rem",
						"bottom": "0.875rem",
						"left":   "1.5rem",
						"right":  "1.5rem"
					}
				},
				"border": {
					"radius": "0"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary)"
					}
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				"typography": {
					"textDecoration": "underline",
					"fontWeight": "500"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "500",
					"textTransform": "uppercase",
					"letterSpacing": "0.05em"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "700",
					"letterSpacing": "-0.02em"
				}
			},
			"core/site-tagline": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "400"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "500"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "700",
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"letterSpacing": "-0.02em"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontStyle": "normal",
					"fontWeight": "500"
				},
				"border": {
					"left": {
						"color": "var(--wp--preset--color--accent)",
						"style": "solid",
						"width": "3px"
					}
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontStyle": "normal",
					"fontWeight": "500"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--border)"
				}
			}
		}
	}
}
