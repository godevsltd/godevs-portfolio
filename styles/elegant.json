{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"title": "Elegant",
	"description": "A refined premium identity — warm cream background, deep brown text, gold accent, larger Newsreader display with italic h1, generous line-height, and subtle shadow on cards. For sophisticated portfolios and editorial brands that want to feel quietly considered.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "primary",    "name": "Primary",     "color": "#2A1F18" },
				{ "slug": "secondary",  "name": "Secondary",   "color": "#5B4636" },
				{ "slug": "accent",      "name": "Accent",      "color": "#B8893E" },
				{ "slug": "background",  "name": "Background",  "color": "#FAF7F2" },
				{ "slug": "surface",     "name": "Surface",     "color": "#F2EBE0" },
				{ "slug": "text",        "name": "Text",        "color": "#2A1F18" },
				{ "slug": "muted",       "name": "Muted Text",  "color": "#8B7D6F" },
				{ "slug": "border",      "name": "Border",      "color": "#E8DCC8" },
				{ "slug": "success",     "name": "Success",     "color": "#4D7C0F" },
				{ "slug": "warning",     "name": "Warning",     "color": "#A16207" },
				{ "slug": "error",       "name": "Error",        "color": "#9F1239" }
			],
			"gradients": [
				{ "slug": "surface-fade", "name": "Surface Fade",
					"gradient": "linear-gradient(180deg, #F2EBE0 0%, #FAF7F2 100%)" },
				{ "slug": "accent-fade",  "name": "Accent Fade",
					"gradient": "linear-gradient(180deg, rgba(184,137,62,0.08) 0%, rgba(184,137,62,0) 100%)" }
			]
		},
		"custom": {
			"radius": {
				"sm": "0",
				"md": "2px",
				"lg": "4px",
				"pill": "999px"
			},
			"shadow": {
				"sm": "0 1px 2px rgba(42, 31, 24, 0.05)",
				"md": "0 2px 8px rgba(42, 31, 24, 0.07)",
				"lg": "0 6px 20px rgba(42, 31, 24, 0.09)"
			}
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"lineHeight": "1.75"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "500",
					"lineHeight": "1.2",
					"letterSpacing": "-0.015em"
				},
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontStyle": "italic",
					"fontWeight": "500",
					"fontSize": "var(--wp--preset--font-size--huge)",
					"lineHeight": "1.05",
					"letterSpacing": "-0.03em"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "500",
					"fontSize": "var(--wp--preset--font-size--xxx-large)",
					"lineHeight": "1.15",
					"letterSpacing": "-0.02em"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "500",
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--background)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "500",
					"fontSize": "var(--wp--preset--font-size--small)",
					"letterSpacing": "0.02em"
				},
				"spacing": {
					"padding": {
						"top":    "0.875rem",
						"bottom": "0.875rem",
						"left":   "1.5rem",
						"right":  "1.5rem"
					}
				},
				"border": {
					"radius": "0"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)"
					},
					"typography": {
						"fontWeight": "500"
					}
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					},
					"color": {
						"text": "var(--wp--preset--color--primary)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontStyle": "italic",
					"letterSpacing": "0.02em"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "500",
					"letterSpacing": "-0.02em"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontStyle": "italic",
					"fontWeight": "500",
					"fontSize": "var(--wp--preset--font-size--huge)",
					"lineHeight": "1.05",
					"letterSpacing": "-0.03em"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontStyle": "italic",
					"fontWeight": "500"
				},
				"border": {
					"left": {
						"color": "var(--wp--preset--color--accent)",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontStyle": "italic",
					"fontWeight": "500"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--border)"
				}
			},
			"core/post-excerpt": {
				"typography": {
					"fontStyle": "italic"
				}
			}
		}
	}
}
