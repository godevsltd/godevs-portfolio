{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"title": "Dark",
	"description": "An inverted editorial palette — near-black background, soft slate text, coral accent preserved for emphasis. Designed for design-forward portfolios and developer sites.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "primary",    "name": "Primary",     "color": "#E2E8F0" },
				{ "slug": "secondary",  "name": "Secondary",   "color": "#94A3B8" },
				{ "slug": "accent",      "name": "Accent",      "color": "#FF8775" },
				{ "slug": "background",  "name": "Background",  "color": "#0B1120" },
				{ "slug": "surface",     "name": "Surface",     "color": "#1E293B" },
				{ "slug": "text",        "name": "Text",        "color": "#E2E8F0" },
				{ "slug": "muted",       "name": "Muted Text",  "color": "#94A3B8" },
				{ "slug": "border",      "name": "Border",      "color": "#334155" },
				{ "slug": "success",     "name": "Success",     "color": "#22C55E" },
				{ "slug": "warning",     "name": "Warning",     "color": "#F59E0B" },
				{ "slug": "error",       "name": "Error",        "color": "#F87171" }
			],
			"gradients": [
				{ "slug": "surface-fade", "name": "Surface Fade",
					"gradient": "linear-gradient(180deg, #1E293B 0%, #0B1120 100%)" },
				{ "slug": "accent-fade",  "name": "Accent Fade",
					"gradient": "linear-gradient(180deg, rgba(255,135,117,0.15) 0%, rgba(255,135,117,0) 100%)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--background)",
			"text": "var(--wp--preset--color--text)"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--background)"
				},
				":hover": {
					"color": {
						"background": "#FF6B57"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"core/post-title": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--border)"
				}
			}
		}
	}
}
