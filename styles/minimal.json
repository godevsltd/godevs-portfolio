{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"title": "Minimal",
	"description": "A lighter interpretation: sans-serif headings, tighter spacing, neutral palette without coral. Useful for editorial portfolios where the photography does the talking.",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "primary",   "name": "Primary",     "color": "#111111" },
				{ "slug": "secondary", "name": "Secondary",   "color": "#374151" },
				{ "slug": "accent",     "name": "Accent",      "color": "#1E293B" },
				{ "slug": "background", "name": "Background",  "color": "#FFFFFF" },
				{ "slug": "surface",    "name": "Surface",     "color": "#FAFAFA" },
				{ "slug": "text",       "name": "Text",        "color": "#111111" },
				{ "slug": "muted",      "name": "Muted Text",  "color": "#6B7280" },
				{ "slug": "border",     "name": "Border",      "color": "#E5E7EB" },
				{ "slug": "success",    "name": "Success",     "color": "#15803D" },
				{ "slug": "warning",    "name": "Warning",     "color": "#B45309" },
				{ "slug": "error",      "name": "Error",       "color": "#B91C1C" }
			],
			"gradients": [
				{ "slug": "surface-fade", "name": "Surface Fade",
					"gradient": "linear-gradient(180deg, #FAFAFA 0%, #FFFFFF 100%)" }
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"lineHeight": "1.7"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "600",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"letterSpacing": "-0.02em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--background)"
				},
				"border": {
					"radius": "0"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "600"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--xxx-large)"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontStyle": "normal"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontStyle": "normal"
				}
			}
		}
	}
}
